# Copy to .env (git-ignored). Never put private keys or seed phrases in this file.
ATOM_MODE=paper
ATOM_STARTING_CAPITAL_EUR=1000
ATOM_TIMEZONE=Europe/Madrid
ATOM_DATABASE_URL=postgresql+asyncpg://atom:CHANGE_ME@localhost:5432/atom

# Risk limits (hard ceilings are enforced in code; values above them are refused)
ATOM_RISK__MIN_RISK_PER_TRADE_PCT=0.5
ATOM_RISK__MAX_RISK_PER_TRADE_PCT=1.0
ATOM_RISK__MAX_DAILY_LOSS_PCT=3.0
ATOM_RISK__MAX_OPEN_POSITIONS=3
ATOM_RISK__MAX_TRADES_PER_DAY=20

# Live trading stays disabled unless ALL of the following are set by the account owner
# AND a live execution provider exists (none does yet):
# ATOM_MODE=live
# ATOM_LIVE_AUTHORIZATION="I AUTHORIZE LIVE TRADING WITH REAL FUNDS"
# ATOM_LIVE_MAX_CAPITAL_EUR=100
